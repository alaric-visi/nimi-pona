{
  "name": "nimi-pona",
  "description": "A calm Toki Pona course-game: vocabulary, grammar and sitelen pona.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:notices && tsc --noEmit && vite build && node scripts/check-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "lint:content": "vitest run tests/content.test.ts",
    "build:glyphs": "node scripts/build-glyphs.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "build:notices": "node scripts/build-notices.mjs",
    "size": "node scripts/check-size.mjs",
    "test:all": "npm run check && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "idb-keyval": "^6.3.0",
    "preact": "^11.2.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "lighthouse": "^12.8.2",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
